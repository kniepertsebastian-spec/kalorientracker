# Serves the built PWA inside the nutrition-frontend container. Security headers and /api routing
# come from the Fitnesstracker's Caddy (site :8080) in front of this one.
{
	admin off
}

:80 {
	root * /srv
	encode zstd gzip

	# Hashed build output: cached for a year. No SPA fallback here, so a chunk of an older build
	# 404s instead of being answered with index.html.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Shell, service worker, manifest and SPA routes: revalidate on every load.
	handle {
		header Cache-Control "no-cache"
		header /manifest.webmanifest Content-Type "application/manifest+json"
		try_files {path} /index.html
		file_server
	}

	handle_errors {
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}"
	}
}
